
cc_binary {
    name: "locIdlClientTest",
    vendor: true,

    cppflags: [
        "-std=c++11",
        "-fexceptions",
        "-Wno-attributes",
        "-Wno-unused-variable",
        "-Wno-unused-parameter"
    ],

    srcs: [
        "LocIdlClientTest.cpp",
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "libgps.utils",
        "libdl",
        "liblog",
    ],

    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "libloc_fidl_if_headers",
        "liblocClient_fidl_if_headers",
        "libLocIdlClientIfV02H_headers",
    ],
    rtti: true,
}
