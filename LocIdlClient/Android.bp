prebuilt_etc {
    name: "commonapi4someip.ini",
    vendor: true,
    src: "src/commonapi4someip.ini",
}

prebuilt_etc {
    name: "vsomeip-client.json",
    vendor: true,
    src: "src/vsomeip-client.json",
}

gen_core_stub_srcs = [
    "src-gen/core/v1/com/qualcomm/qti/location/*Stub*.cpp"
]
gen_core_proxy_srcs = [
    "src-gen/core/v1/com/qualcomm/qti/location/*Proxy.cpp"
]

gen_someip_srcs = [
    "src-gen/someip/v1/com/qualcomm/qti/location/*.cpp"
]

cc_defaults {
    name: "locSomeip_defaults",
    vendor: true,

    cppflags: [
        "-std=c++11",
        "-fexceptions",
        "-Wno-attributes",
        "-Wno-unused-variable",
        "-Wno-unused-parameter"
    ],

    shared_libs: [
        "libvsomeip",
        "libvsomeip_cfg",
        "libvsomeip_e2e",
        "libvsomeip_sd",
        "libCommonAPI-SomeIP",
        "libCommonAPI",
        "liblog",
        "libdl",
    ],

    rtti: true,
}

cc_library_headers {
    name: "libLocIdlAPI-proxy_headers",
    export_include_dirs: [
       "src-gen/someip",
       "src-gen/core",
    ],
    vendor: true,
}

cc_library_headers {
    name: "libLocIdlClientIfV02H_headers",
    export_include_dirs: [
       "inc",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libLocation-someip",
    vendor: true,
    srcs: gen_someip_srcs,
    defaults: [
        "locSomeip_defaults"
    ],
    local_include_dirs: [
       "src-gen/someip",
       "src-gen/core",
    ]
}

cc_library_shared {
    name: "libLocation-proxy",
    vendor: true,
    srcs: gen_core_proxy_srcs,
    defaults: [
        "locSomeip_defaults"
    ],
    local_include_dirs: [
       "src-gen/someip",
       "src-gen/core",
    ]
}

cc_binary {
    name: "LocIdlAPIClient",
    defaults: ["locSomeip_defaults"],

    srcs: [
        "src/LocIdlAPIClient.cpp",
    ],
    local_include_dirs: [
       "src",
    ],
    shared_libs: [
       "libLocation-someip",
       "libLocation-proxy",
    ],

    header_libs: [
       "libgptp_headers",
       "libLocIdlAPI-proxy_headers",
    ],
}

cc_binary {
    name: "locIdlClient_daemon",
    defaults: ["locSomeip_defaults"],

    srcs: [
        "diag/src/LocIdlclientDiagLogTypes.cpp",
        "daemon/LocIdlClientDeviceMsgHandler.cpp",
        "daemon/LocIdlClientDeviceMsgParser.cpp",
        "daemon/LocIdlClientDevice.cpp",
    ],
    local_include_dirs: [
        "inc",
        "daemon",
        "diag/inc/",
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "liblocdiagiface",
        "liblog",
        "libgps.utils",
        "libLocation-someip",
        "libLocation-proxy",
    ],

    header_libs: [
        "libgps.utils_headers",
        "libloc_pla_headers",
        "vendor_common_inc",
        "liblocation_api_headers",
        "libloc_fidl_if_headers",
        "liblocClient_fidl_if_headers",
        "libgptp_headers",
        "libLocIdlAPI-proxy_headers",
        "libdiag_headers",
        "libloc_base_util_headers",
        "libloc_diag_iface_headers",
    ],
}

cc_library_shared {
    name: "libLocationFidlV02",
    vendor: true,

    cppflags: [
        "-std=c++11",
        "-fexceptions",
        "-Wno-attributes",
        "-Wno-unused-variable",
        "-Wno-unused-parameter"
    ],

    srcs: [
        "lib/LocIdlClientV02Api.cpp",
    ],

    local_include_dirs: [
       "inc",
       "lib",
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "libgps.utils",
        "libdl",
        "liblog",
    ],

    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "libloc_fidl_if_headers",
        "liblocClient_fidl_if_headers",
    ],
    rtti: true,
}

